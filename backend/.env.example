# Copy to backend/.env and replace local placeholders. Never commit backend/.env.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=generate-a-local-secret-with-python-secrets
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=ap_automation
DB_USER=ap_app
DB_PASSWORD=replace-with-your-local-database-password
DB_HOST=127.0.0.1
DB_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
